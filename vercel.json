{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && node scripts/db-migrate.mjs --if-preview",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth"
    }
  ],
  "functions": {
    "api/auth.js": {
      "maxDuration": 60
    }
  }
}
